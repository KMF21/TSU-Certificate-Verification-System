# Public URL printed in QR codes. Leave empty on previews to use the request host.
NEXT_PUBLIC_SITE_URL=

# Supabase (wired in the next slice)
NEXT_PUBLIC_SUPABASE_URL=https://iyevboqnlflnonknliou.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signing. Generate with `pnpm keys:generate`. Previews fall back to the public demo key.
TSU_SIGNING_PRIVATE_JWK=
# JSON array of retired public JWKs that must keep verifying older certificates.
TSU_RETIRED_PUBLIC_JWKS=

# Set to "production" on the live site: refuses the demo key and turns off /demo.
TSU_ENV=
